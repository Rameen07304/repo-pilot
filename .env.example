# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM providers ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
LLM_PRIMARY_PROVIDER=gemini

# --- GitHub access ---
GITHUB_TOKEN=your_github_pat_here

# --- Storage paths ---
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/app.db

# --- Ingestion limits ---
MAX_FILES_PER_REPO=500
MAX_FILE_SIZE_BYTES=102400
MAX_TOTAL_REPO_SIZE_BYTES=5242880

# --- Rate limiting ---
RATE_LIMIT_QUESTIONS_PER_HOUR_PER_IP=10
RATE_LIMIT_DEEP_INVESTIGATIONS_PER_HOUR_PER_IP=3
DAILY_QUOTA_SOFT_LIMIT_PERCENT=80
LLM_FREE_TIER_DAILY_REQUEST_CAP=1500
# Set to true ONLY when deployed behind a reverse proxy you control
# (HF Spaces, nginx). Otherwise X-Forwarded-For is client-supplied and
# would let anyone bypass the per-IP limits above.
TRUST_PROXY_HEADERS=false

# --- Deep investigation mode ---
DEEP_INVESTIGATION_MAX_STEPS=5

# --- Onboarding guide ---
# How many files the reading order aims for.
ONBOARDING_MIN_FILES=5
ONBOARDING_MAX_FILES=8

# --- Impact analysis ---
# Bounds on the reverse dependency walk. Depth is how many hops out
# from the changed file; nodes is the hard stop for very dense graphs.
IMPACT_MAX_DEPTH=4
IMPACT_MAX_NODES=200

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Limits for a public deployment ---
# Each caller's share of the day's model budget. The global cap above is
# the ceiling for everyone together; this stops the first visitor of the
# day spending all of it before the second one arrives.
RATE_LIMIT_LLM_CALLS_PER_DAY_PER_IP=60

# How many repositories the store keeps, oldest evicted first. Anyone can
# make a public deployment ingest an arbitrary public repo, so without a
# lid the disk fills and every repo breaks at once. 0 disables the cap.
MAX_CACHED_REPOS=50
