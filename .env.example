# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM providers ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
LLM_PRIMARY_PROVIDER=gemini

# --- GitHub access ---
GITHUB_TOKEN=your_github_pat_here

# --- Storage paths ---
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/app.db

# --- Ingestion limits ---
MAX_FILES_PER_REPO=500
MAX_FILE_SIZE_BYTES=102400
MAX_TOTAL_REPO_SIZE_BYTES=5242880

# --- Rate limiting ---
RATE_LIMIT_QUESTIONS_PER_HOUR_PER_IP=10
RATE_LIMIT_DEEP_INVESTIGATIONS_PER_HOUR_PER_IP=3
DAILY_QUOTA_SOFT_LIMIT_PERCENT=80
LLM_FREE_TIER_DAILY_REQUEST_CAP=1500

# --- Deep investigation mode ---
DEEP_INVESTIGATION_MAX_STEPS=5

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO